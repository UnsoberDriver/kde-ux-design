#!/usr/bin/env python3
"""Bascule l'activité Discord avec AltGr + ':' / '!' / 'a'.

Sur KDE Wayland, les raccourcis X11 ne sont pas fiables : on lit donc
directement le périphérique clavier via evdev (aucun paquet supplémentaire).

Profils :
    AltGr + :  -> LARPING_CLIENT_ID   (défaut : exemple public pypresence)
    AltGr + !  -> GAME_CLIENT_ID      (défaut : 1575228314140803175)
    AltGr + a  -> GAME2_CLIENT_ID     (défaut : 1575411671898267740)

Appuyer sur le même raccourci coupe l'activité ; appuyer sur un autre
remplace l'activité courante par celle de l'autre profil.

Usage :
    larping --daemon        # démon (utilisé par le service systemd)
    larping --toggle        # bascule le profil ':'
    larping --game          # bascule le profil '!'
    larping --game2         # bascule le profil 'a'
    larping --status        # affiche le profil actif
"""

import json
import os
import select
import signal
import socket
import struct
import sys
import threading
import uuid
from pathlib import Path

HOME = Path.home()
STATE_DIR = HOME / ".local" / "state" / "larping"
STATE_FILE = STATE_DIR / "state"
PID_FILE = STATE_DIR / "daemon.pid"

EV_KEY = 1
KEY_DOT = 52       # touche « : » sur AZERTY français (evdev KEY_DOT)
KEY_SLASH = 53     # touche « ! » sur AZERTY français (evdev KEY_SLASH)
KEY_A = 30         # touche « a » (evdev KEY_A)
KEY_RIGHTALT = 100  # AltGr

EVENT_SIZE = struct.calcsize("qqHHI")  # timeval + type + code + value

# Profil 1 : AltGr + ':' — l'appli Larping déjà en place (ID local via override).
# Profil 2 : AltGr + '!' — le premier jeu fourni par l'utilisateur.
# Profil 3 : AltGr + 'a' — le second jeu fourni par l'utilisateur.
PROFILES = {
    KEY_DOT: {
        "label": "Larping",
        "client_id": os.environ.get("LARPING_CLIENT_ID", "717091213148160041"),
        "name": os.environ.get("LARPING_NAME", "Larping"),
        "icon": os.environ.get("LARPING_ICON_URL", ""),
    },
    KEY_SLASH: {
        "label": "Jeu",
        "client_id": os.environ.get("GAME_CLIENT_ID", "1575228314140803175"),
        "name": os.environ.get("GAME_NAME", "Larping"),
        "icon": os.environ.get("GAME_ICON_URL", ""),
    },
    KEY_A: {
        "label": "Uncovering things",
        "client_id": os.environ.get("GAME2_CLIENT_ID", "1575411671898267740"),
        "name": os.environ.get("GAME2_NAME", "Uncovering things"),
        "icon": os.environ.get("GAME2_ICON_URL", ""),
    },
}
PROFILE_KEYS = tuple(PROFILES)


def log(msg):
    print(f"[larping] {msg}", flush=True)


def find_keyboard_device():
    """Premier périphérique clavier évdev lisible (fallback event2)."""
    try:
        text = Path("/proc/bus/input/devices").read_text()
    except OSError:
        return "/dev/input/event2"
    for block in text.split("\n\n"):
        if "keyboard" not in block.lower():
            continue
        for line in block.splitlines():
            if not line.startswith("H: Handlers="):
                continue
            for token in line.split("=", 1)[1].split():
                if token.startswith("event"):
                    path = f"/dev/input/{token}"
                    if os.access(path, os.R_OK):
                        return path
    return "/dev/input/event2"


# Détection automatique du clavier ; surchargeable via LARPING_KEYBOARD.
KEYBOARD_DEVICE = os.environ.get("LARPING_KEYBOARD") or find_keyboard_device()

def read_state():
    """Renvoie le code du profil actif, ou 0. Migre l'ancien état '1'."""
    try:
        raw = STATE_FILE.read_text().strip()
    except OSError:
        return 0
    if raw == "1":
        return KEY_DOT
    try:
        key = int(raw)
    except ValueError:
        return 0
    return key if key in PROFILES else 0


def write_state(key):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(str(key if key in PROFILES else 0))


def find_ipc_socket():
    runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    uid = os.getuid()
    candidates = []
    for i in range(10):
        candidates.append(f"{runtime}/discord-ipc-{i}")
        candidates.append(f"{runtime}/app/com.discordapp.Discord/discord-ipc-{i}")
        candidates.append(f"/run/user/{uid}/app/com.discordapp.Discord/discord-ipc-{i}")
    seen = set()
    for path in candidates:
        if path in seen:
            continue
        seen.add(path)
        try:
            if os.path.exists(path):
                return path
        except OSError:
            pass
    return None


def send_frame(sock, opcode, payload):
    data = json.dumps(payload).encode()
    sock.sendall(struct.pack("<II", opcode, len(data)) + data)


def recv_exact(sock, size):
    chunks = []
    remaining = size
    while remaining:
        chunk = sock.recv(remaining)
        if not chunk:
            raise ConnectionError("socket Discord fermé")
        chunks.append(chunk)
        remaining -= len(chunk)
    return b"".join(chunks)


def read_frame(sock):
    opcode, length = struct.unpack("<II", recv_exact(sock, 8))
    return opcode, json.loads(recv_exact(sock, length).decode())


class Presence(threading.Thread):
    """Garde une connexion IPC et applique le profil voulu."""

    def __init__(self):
        super().__init__(daemon=True)
        self.stop_event = threading.Event()
        self.lock = threading.Lock()
        self.want = read_state()
        self.applied = 0
        self.connected_client_id = None

    def set_want(self, value):
        with self.lock:
            self.want = value

    def get_want(self):
        with self.lock:
            return self.want

    def request(self, sock, cmd, args, timeout=3.0):
        nonce = uuid.uuid4().hex
        old_timeout = sock.gettimeout()
        sock.settimeout(timeout)
        try:
            send_frame(sock, 1, {"cmd": cmd, "args": args, "nonce": nonce})
            while True:
                _opcode, payload = read_frame(sock)
                if payload.get("nonce") == nonce:
                    data = payload.get("data") or {}
                    if payload.get("evt") == "ERROR" or "code" in data:
                        raise RuntimeError(str(data))
                    return payload
        finally:
            sock.settimeout(old_timeout)

    def apply(self, sock, key):
        profile = PROFILES.get(key)
        activity = None
        if profile:
            activity = {"name": profile["name"], "type": 0}
            if profile["icon"]:
                activity["assets"] = {
                    "small_image": profile["icon"],
                    "small_text": profile["name"],
                }
        self.request(
            sock,
            "SET_ACTIVITY",
            {"pid": os.getpid(), "activity": activity},
        )
        self.applied = key
        log("activité " + (f"activée : {profile['label']}" if profile else "désactivée"))

    def run(self):
        sock = None
        try:
            while not self.stop_event.is_set():
                want = self.get_want()
                profile = PROFILES.get(want)

                # Un changement de client ID impose une nouvelle connexion IPC.
                if profile and self.connected_client_id != profile["client_id"]:
                    if sock:
                        try:
                            sock.close()
                        except OSError:
                            pass
                    sock = None
                    self.connected_client_id = None
                    self.applied = 0

                if sock is None:
                    try:
                        path = find_ipc_socket()
                        if not path:
                            raise ConnectionError("socket IPC Discord introuvable")
                        client_id = (
                            profile["client_id"]
                            if profile
                            else (self.connected_client_id or next(iter(PROFILES.values()))["client_id"])
                        )
                        sock = socket.socket(socket.AF_UNIX)
                        sock.settimeout(3.0)
                        sock.connect(path)
                        send_frame(sock, 0, {"v": 1, "client_id": client_id})
                        _opcode, payload = read_frame(sock)
                        if payload.get("evt") == "ERROR":
                            raise RuntimeError(str(payload))
                        self.connected_client_id = client_id
                        self.applied = 0
                        log(f"connecté à Discord avec {client_id}")
                    except Exception as exc:
                        if sock:
                            try:
                                sock.close()
                            except OSError:
                                pass
                        sock = None
                        self.connected_client_id = None
                        if not self.stop_event.is_set():
                            log(f"IPC: {exc} — nouvelle tentative dans 2 s")
                        self.stop_event.wait(2)
                    continue

                if want != self.applied:
                    try:
                        self.apply(sock, want)
                    except Exception as exc:
                        log(f"SET_ACTIVITY: {exc} — reconnexion")
                        try:
                            sock.close()
                        except OSError:
                            pass
                        sock = None
                        self.connected_client_id = None
                        self.applied = 0
                    continue

                sock.settimeout(0.5)
                try:
                    opcode, _payload = read_frame(sock)
                    if opcode == 2:  # CLOSE
                        raise ConnectionError("Discord a fermé la connexion")
                except socket.timeout:
                    continue
                except Exception as exc:
                    log(f"IPC: {exc} — reconnexion")
                    try:
                        sock.close()
                    except OSError:
                        pass
                    sock = None
                    self.connected_client_id = None
                    self.applied = 0
        finally:
            if sock:
                try:
                    sock.close()
                except OSError:
                    pass

    def stop(self):
        self.stop_event.set()


def switch(presence, key):
    """Active le profil 'key', ou le coupe si c'était déjà le profil actif."""
    current = read_state()
    new = 0 if current == key else key
    write_state(new)
    if presence:
        presence.set_want(new)
    label = PROFILES.get(new, {}).get("label", "OFF")
    log(f">>> {'ON : ' + label if new else 'OFF'}")
    return new


def daemon():
    presence = Presence()
    presence.start()

    def on_sigusr1(_signum, _frame):
        switch(presence, KEY_DOT)

    def on_sigusr2(_signum, _frame):
        switch(presence, KEY_SLASH)

    def on_sighup(_signum, _frame):
        switch(presence, KEY_A)

    def on_sigterm(_signum, _frame):
        write_state(0)
        presence.set_want(0)
        presence.stop()

    signal.signal(signal.SIGUSR1, on_sigusr1)
    signal.signal(signal.SIGUSR2, on_sigusr2)
    signal.signal(signal.SIGHUP, on_sighup)
    signal.signal(signal.SIGTERM, on_sigterm)
    signal.signal(signal.SIGINT, on_sigterm)

    STATE_DIR.mkdir(parents=True, exist_ok=True)
    PID_FILE.write_text(str(os.getpid()))

    log(
        f"démon prêt — AltGr + ':' = {PROFILES[KEY_DOT]['client_id']}, "
        f"AltGr + '!' = {PROFILES[KEY_SLASH]['client_id']}, "
        f"AltGr + 'a' = {PROFILES[KEY_A]['client_id']} (clavier {KEYBOARD_DEVICE})"
    )
    try:
        fd = os.open(KEYBOARD_DEVICE, os.O_RDONLY | os.O_NONBLOCK)
    except OSError as exc:
        log(f"impossible d'ouvrir {KEYBOARD_DEVICE}: {exc}")
        fd = None

    pressed = set()
    latched = set()
    profile_keys = PROFILE_KEYS
    try:
        while not presence.stop_event.is_set():
            if fd is None:
                presence.stop_event.wait(1)
                continue
            readable, _, _ = select.select([fd], [], [], 0.5)
            if not readable:
                continue
            try:
                data = os.read(fd, EVENT_SIZE * 128)
            except BlockingIOError:
                continue
            for offset in range(0, len(data) - EVENT_SIZE + 1, EVENT_SIZE):
                _sec, _usec, ev_type, code, value = struct.unpack(
                    "qqHHI", data[offset : offset + EVENT_SIZE]
                )
                if ev_type != EV_KEY or code not in (KEY_RIGHTALT,) + profile_keys:
                    continue
                if value:
                    pressed.add(code)
                else:
                    pressed.discard(code)
                for key in profile_keys:
                    both = KEY_RIGHTALT in pressed and key in pressed
                    if both and key not in latched:
                        latched.add(key)
                        switch(presence, key)
                    elif not both:
                        latched.discard(key)
    finally:
        if fd is not None:
            os.close(fd)
        presence.stop()
        presence.join(timeout=2)
        try:
            if PID_FILE.read_text().strip() == str(os.getpid()):
                PID_FILE.unlink()
        except OSError:
            pass
        log("arrêté")


def signal_daemon(signum, label):
    try:
        pid = int(PID_FILE.read_text().strip())
        os.kill(pid, signum)
        print(label, flush=True)
    except (OSError, ValueError) as exc:
        print(
            f"démon non joignable ({exc}) — lance-le avec : systemctl --user start larping.service",
            file=sys.stderr,
        )
        sys.exit(1)


def main():
    args = set(sys.argv[1:])
    if "--daemon" in args:
        daemon()
    elif "--game" in args:
        signal_daemon(signal.SIGUSR2, "bascule Jeu demandée")
    elif "--game2" in args:
        signal_daemon(signal.SIGHUP, "bascule Uncovering things demandée")
    elif "--toggle" in args:
        signal_daemon(signal.SIGUSR1, "bascule Larping demandée")
    elif "--status" in args:
        key = read_state()
        print("Activité : " + (PROFILES[key]["label"] if key else "OFF"))
    else:
        print(__doc__)


if __name__ == "__main__":
    main()
