#!/usr/bin/env python3
"""Bascule l'activité Discord « Larping » avec AltGr + la touche ':'.

Sur KDE Wayland, les raccourcis X11 ne sont pas fiables : on lit donc
directement le périphérique clavier via evdev (aucun paquet supplémentaire).

Usage :
    larping --daemon    # démon (utilisé par le service systemd)
    larping --toggle    # bascule manuellement
    larping --status    # affiche l'état courant
"""

import json
import os
import select
import signal
import socket
import struct
import sys
import threading
import time
import uuid
from pathlib import Path

HOME = Path.home()
STATE_DIR = HOME / ".local" / "state" / "larping"
STATE_FILE = STATE_DIR / "state"
PID_FILE = STATE_DIR / "daemon.pid"

# Client ID public tiré des exemples pypresence (application « Apple Music »,
# d'où la note de musique). Mets le tien pour avoir ta propre icône.
CLIENT_ID = os.environ.get("LARPING_CLIENT_ID", "717091213148160041")
ACTIVITY_NAME = os.environ.get("LARPING_NAME", "Larping")
# Icône optionnelle (URL publique) envoyée comme small_image de l'activité.
ICON_URL = os.environ.get("LARPING_ICON_URL", "")

def find_keyboard_device():
    """Premier périphérique clavier évdev lisible (fallback event2)."""
    try:
        text = Path("/proc/bus/input/devices").read_text()
    except OSError:
        return "/dev/input/event2"
    for block in text.split("\n\n"):
        if "keyboard" not in block.lower():
            continue
        for line in block.splitlines():
            if not line.startswith("H: Handlers="):
                continue
            for token in line.split("=", 1)[1].split():
                if token.startswith("event"):
                    path = f"/dev/input/{token}"
                    if os.access(path, os.R_OK):
                        return path
    return "/dev/input/event2"


# Détection automatique du clavier ; surchargeable via LARPING_KEYBOARD.
KEYBOARD_DEVICE = os.environ.get("LARPING_KEYBOARD") or find_keyboard_device()

EV_KEY = 1
KEY_DOT = 52    # touche « : » sur clavier AZERTY français (evdev)
KEY_RIGHTALT = 100  # AltGr

EVENT_SIZE = struct.calcsize("qqHHI")  # timeval + type + code + value


def log(msg):
    print(f"[larping] {msg}", flush=True)


def read_state():
    try:
        return STATE_FILE.read_text().strip() == "1"
    except OSError:
        return False


def write_state(value):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text("1" if value else "0")


def find_ipc_socket():
    runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    uid = os.getuid()
    candidates = []
    for i in range(10):
        candidates.append(f"{runtime}/discord-ipc-{i}")
        candidates.append(f"{runtime}/app/com.discordapp.Discord/discord-ipc-{i}")
        candidates.append(f"/run/user/{uid}/app/com.discordapp.Discord/discord-ipc-{i}")
    for path in candidates:
        if path in seen_paths:
            continue
        seen_paths.add(path)
        try:
            if os.path.exists(path):
                socket.socket(socket.AF_UNIX).close()  # juste pour valider l'accès
                return path
        except OSError:
            pass
    return None


seen_paths = set()


def send_frame(sock, opcode, payload):
    data = json.dumps(payload).encode()
    sock.sendall(struct.pack("<II", opcode, len(data)) + data)


def recv_exact(sock, size):
    chunks = []
    remaining = size
    while remaining:
        chunk = sock.recv(remaining)
        if not chunk:
            raise ConnectionError("socket Discord fermé")
        chunks.append(chunk)
        remaining -= len(chunk)
    return b"".join(chunks)


def read_frame(sock):
    opcode, length = struct.unpack("<II", recv_exact(sock, 8))
    return opcode, json.loads(recv_exact(sock, length).decode())


class Presence(threading.Thread):
    """Garde une connexion IPC ouverte et applique l'état voulu."""

    def __init__(self):
        super().__init__(daemon=True)
        self.stop_event = threading.Event()
        self.lock = threading.Lock()
        self.want = read_state()
        self.applied = None

    def set_want(self, value):
        with self.lock:
            self.want = value

    def get_want(self):
        with self.lock:
            return self.want

    def request(self, sock, cmd, args, timeout=3.0):
        nonce = uuid.uuid4().hex
        old_timeout = sock.gettimeout()
        sock.settimeout(timeout)
        try:
            send_frame(sock, 1, {"cmd": cmd, "args": args, "nonce": nonce})
            while True:
                opcode, payload = read_frame(sock)
                if payload.get("nonce") == nonce:
                    data = payload.get("data") or {}
                    if payload.get("evt") == "ERROR" or "code" in data:
                        raise RuntimeError(str(data))
                    return payload
        finally:
            sock.settimeout(old_timeout)

    def apply(self, sock, enabled):
        activity = None
        if enabled:
            activity = {"name": ACTIVITY_NAME, "type": 0}
            if ICON_URL:
                activity["assets"] = {
                    "small_image": ICON_URL,
                    "small_text": ACTIVITY_NAME,
                }
        self.request(
            sock,
            "SET_ACTIVITY",
            {"pid": os.getpid(), "activity": activity},
        )
        self.applied = enabled
        log("activité " + ("activée" if enabled else "désactivée"))

    def run(self):
        while not self.stop_event.is_set():
            sock = None
            try:
                path = find_ipc_socket()
                if not path:
                    raise ConnectionError("socket IPC Discord introuvable")
                sock = socket.socket(socket.AF_UNIX)
                sock.settimeout(3.0)
                sock.connect(path)
                send_frame(sock, 0, {"v": 1, "client_id": CLIENT_ID})
                opcode, payload = read_frame(sock)
                if opcode == 2 or payload.get("evt") == "ERROR":
                    raise RuntimeError(str(payload))
                log(f"connecté à Discord ({payload.get('data', {}).get('user', {}).get('username', '?')})")
                self.applied = None

                while not self.stop_event.is_set():
                    if self.get_want() != self.applied:
                        self.apply(sock, self.get_want())
                    sock.settimeout(0.5)
                    try:
                        opcode, payload = read_frame(sock)
                        if opcode == 2:  # CLOSE
                            raise ConnectionError("Discord a fermé la connexion")
                    except socket.timeout:
                        continue
            except Exception as exc:
                if not self.stop_event.is_set():
                    log(f"IPC: {exc} — nouvelle tentative dans 2 s")
            finally:
                if sock:
                    try:
                        sock.close()
                    except OSError:
                        pass
            self.stop_event.wait(2)

    def stop(self):
        self.stop_event.set()


def toggle(presence=None):
    new_state = not read_state()
    write_state(new_state)
    if presence:
        presence.set_want(new_state)
    log(">>> " + ("ON : Larping" if new_state else "OFF"))
    return new_state


def daemon():
    presence = Presence()
    presence.start()

    def on_sigusr1(_signum, _frame):
        toggle(presence)

    def on_sigterm(_signum, _frame):
        write_state(False)
        presence.set_want(False)
        presence.stop()

    signal.signal(signal.SIGUSR1, on_sigusr1)
    signal.signal(signal.SIGTERM, on_sigterm)
    signal.signal(signal.SIGINT, on_sigterm)

    STATE_DIR.mkdir(parents=True, exist_ok=True)
    PID_FILE.write_text(str(os.getpid()))

    log(f"démon prêt — AltGr + ':' (clavier {KEYBOARD_DEVICE})")
    try:
        fd = os.open(KEYBOARD_DEVICE, os.O_RDONLY | os.O_NONBLOCK)
    except OSError as exc:
        log(f"impossible d'ouvrir {KEYBOARD_DEVICE}: {exc}")
        fd = None

    pressed = set()
    latched = False
    try:
        while not presence.stop_event.is_set():
            if fd is None:
                presence.stop_event.wait(1)
                continue
            readable, _, _ = select.select([fd], [], [], 0.5)
            if not readable:
                continue
            try:
                data = os.read(fd, EVENT_SIZE * 128)
            except BlockingIOError:
                continue
            for offset in range(0, len(data) - EVENT_SIZE + 1, EVENT_SIZE):
                _sec, _usec, ev_type, code, value = struct.unpack(
                    "qqHHI", data[offset : offset + EVENT_SIZE]
                )
                if ev_type != EV_KEY or code not in (KEY_RIGHTALT, KEY_DOT):
                    continue
                if value:
                    pressed.add(code)
                else:
                    pressed.discard(code)
                both = KEY_RIGHTALT in pressed and KEY_DOT in pressed
                if both and not latched:
                    latched = True
                    toggle(presence)
                elif not both:
                    latched = False
    finally:
        if fd is not None:
            os.close(fd)
        presence.stop()
        presence.join(timeout=2)
        try:
            # Ne supprime le fichier que s'il contient encore notre PID :
            # évite d'effacer celui du service redémarré entre-temps.
            if PID_FILE.read_text().strip() == str(os.getpid()):
                PID_FILE.unlink()
        except OSError:
            pass
        log("arrêté")


def main():
    args = set(sys.argv[1:])
    if "--daemon" in args:
        daemon()
    elif "--toggle" in args:
        try:
            pid = int(PID_FILE.read_text().strip())
            os.kill(pid, signal.SIGUSR1)
            print("bascule demandée")
        except (OSError, ValueError) as exc:
            print(f"démon non joignable ({exc}) — lance-le avec : systemctl --user start larping.service")
            sys.exit(1)
    elif "--status" in args:
        print("Larping: " + ("ON" if read_state() else "OFF"))
    else:
        print(__doc__)


if __name__ == "__main__":
    main()
